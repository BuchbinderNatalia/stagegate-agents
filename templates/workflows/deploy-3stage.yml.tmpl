# SPDX-License-Identifier: Apache-2.0
# ─────────────────────────────────────────────────────────────────────────────
# {{ project.name }} — deploy pipeline (generated by stagegate-agents, infra pack)
#
#   Stage 0  tests            a red test stops everything below
#   Stage 1  infrastructure   plan (published to the run summary) → approval → apply
#                             exactly the reviewed plan ({{ infra.iac_dir }}/)
#   Stage 2  platform         Helm releases for platform services (extension point)
#   Stage 3  deploy           build → scan (fail CRITICAL/HIGH) → push → {{#if infra.argocd}}tag commit (own job)
#                             → wait until ArgoCD runs that exact revision, Synced + Healthy{{else}}kubectl apply → rollout{{/if}}
#
# Security defaults:
#   - AWS credentials via OIDC, no stored keys. Two roles, ARNs in repository variables:
#       {{ infra.plan_role_variable }}   read-only, assumed by the plan job (trust: this repo, {{ project.default_branch }})
#       {{ infra.deploy_role_variable }} assumed only inside the "{{ infra.environment }}" environment
#                          (trust condition sub = repo:<owner>/<repo>:environment:{{ infra.environment }})
#   - every action pinned to a commit SHA; least-privilege permissions per job
#   - apply and deploy jobs run in the GitHub environment "{{ infra.environment }}": add
#     required reviewers to it (Settings → Environments). They approve AFTER the plan job
#     has published the plan, and apply refuses to run if the plan changed since
#   - one deploy at a time (concurrency, never cancelled mid-apply)
#
# Before the first run: create both IAM roles with GitHub OIDC trust policies, the repository
# variables {{ infra.plan_role_variable }} and {{ infra.deploy_role_variable }}, and the
# "{{ infra.environment }}" environment with required reviewers.
# ─────────────────────────────────────────────────────────────────────────────

name: Deploy

on:
  push:
    branches: [{{ project.default_branch }}]
    paths-ignore: ["**.md", "docs/**", ".claude/**", ".gitignore"]
  workflow_dispatch:

permissions:
  contents: read # checkout only; jobs widen this where needed

concurrency:
  group: deploy-{{ infra.environment }}
  cancel-in-progress: false

env:
  AWS_REGION: {{ infra.region }}
  CLUSTER_NAME: {{#if infra.cluster}}{{ infra.cluster }}{{else}}CHANGE-ME-cluster{{/if}}
  IMAGE_REPO: {{#if infra.registry}}{{ infra.registry }}{{else}}CHANGE-ME.dkr.ecr.{{ infra.region }}.amazonaws.com/{{ infra.app_name }}{{/if}}
  APP_NAME: {{ infra.app_name }}
  NAMESPACE: {{ infra.namespace }}

jobs:
  # ── Stage 0 ────────────────────────────────────────────────────────────────
  tests:
    name: "Stage 0 · tests"
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      # Adjust setup to your stack (language runtime, services) if the command needs it.
      - name: Run tests
        run: {{ cmd.test }}

  # ── Stage 1a · plan (read-only; the reviewer reads this) ─────────────────
  plan:
    name: "Stage 1a · terraform plan"
    needs: tests
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read # checkout
      id-token: write # assume the AWS role via OIDC
    outputs:
      fingerprint: ${{ steps.plan.outputs.fingerprint }}
    defaults:
      run:
        working-directory: {{ infra.iac_dir }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: aws-actions/configure-aws-credentials@e1253824e5c10ff9df46874f81ed3ec929e19cfd # v6.3.0
        with:
          role-to-assume: ${{ vars.{{ infra.plan_role_variable }} }}
          aws-region: ${{ env.AWS_REGION }}
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          terraform_wrapper: false
      - run: terraform init -input=false
      - run: terraform fmt -check -recursive
      - run: terraform validate
      - name: Plan, publish it to the run summary, fingerprint it
        id: plan
        run: |
          set -euo pipefail
          terraform plan -input=false -lock=false -out=tfplan
          {
            echo "### Terraform plan (review before approving the {{ infra.environment }} deploy)"
            echo '```'
            terraform show -no-color tfplan   # sensitive values are shown as (sensitive value)
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
          # What changes, and how: the apply job refuses to run if this differs.
          fp=$(terraform show -json tfplan |
            jq -cS '[.resource_changes[]? | {address, actions: .change.actions}]' | sha256sum | cut -d' ' -f1)
          echo "fingerprint=$fp" >> "$GITHUB_OUTPUT"
      # The plan file is NOT uploaded: plan files can contain secrets in plain text, and
      # artifacts of public repositories are downloadable by any signed-in GitHub user.

  # ── Stage 1b · apply exactly what was reviewed ─────────────────────────────
  infrastructure:
    name: "Stage 1b · terraform apply"
    needs: plan
    runs-on: ubuntu-latest
    environment: {{ infra.environment }} # required reviewers approve here, after reading the plan
    timeout-minutes: 45
    permissions:
      contents: read # checkout
      id-token: write # assume the AWS role via OIDC
    defaults:
      run:
        working-directory: {{ infra.iac_dir }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: aws-actions/configure-aws-credentials@e1253824e5c10ff9df46874f81ed3ec929e19cfd # v6.3.0
        with:
          role-to-assume: ${{ vars.{{ infra.deploy_role_variable }} }}
          aws-region: ${{ env.AWS_REGION }}
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          terraform_wrapper: false
      - run: terraform init -input=false
      - name: Re-plan and refuse if it differs from the reviewed plan
        env:
          REVIEWED: ${{ needs.plan.outputs.fingerprint }}
        run: |
          set -euo pipefail
          terraform plan -input=false -out=tfplan
          fp=$(terraform show -json tfplan |
            jq -cS '[.resource_changes[]? | {address, actions: .change.actions}]' | sha256sum | cut -d' ' -f1)
          if [ "$fp" != "$REVIEWED" ]; then
            echo "::error::The plan changed after it was reviewed. Re-run the workflow and review the new plan."
            exit 1
          fi
      - run: terraform apply -input=false tfplan

  # ── Stage 2 ────────────────────────────────────────────────────────────────
  platform:
    name: "Stage 2 · platform"
    needs: infrastructure
    runs-on: ubuntu-latest
    environment: {{ infra.environment }}
    timeout-minutes: 30
    permissions:
      contents: read # checkout
      id-token: write # assume the AWS role via OIDC
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: aws-actions/configure-aws-credentials@e1253824e5c10ff9df46874f81ed3ec929e19cfd # v6.3.0
        with:
          role-to-assume: ${{ vars.{{ infra.deploy_role_variable }} }}
          aws-region: ${{ env.AWS_REGION }}
      - uses: azure/setup-kubectl@bda439f5f36b99b262ebdcd3613869bddb064c8e # v5.2.0
      - name: Configure cluster access
        run: aws eks update-kubeconfig --name "$CLUSTER_NAME" --region "$AWS_REGION"
      # Extension point: one step per platform release, chart version pinned, values in git.
      # {{#if infra.argocd}}Releases you migrate to ArgoCD must be REMOVED from here (one owner per release).{{/if}}
      # - name: ingress-nginx
      #   run: >-
      #     helm upgrade --install ingress-nginx ingress-nginx
      #     --repo https://kubernetes.github.io/ingress-nginx --version <PINNED>
      #     -n ingress-nginx --create-namespace -f {{ infra.k8s_dir }}/platform/ingress-nginx/values.yaml --wait
      - name: Platform releases
        run: echo "No platform releases configured yet (see the commented example above)."

  # ── Stage 3 ────────────────────────────────────────────────────────────────
  deploy:
    name: "Stage 3 · build, scan, deploy"
    needs: platform
    runs-on: ubuntu-latest
    environment: {{ infra.environment }}
    timeout-minutes: 30
    permissions:
      contents: read # checkout
      id-token: write # assume the AWS role via OIDC
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: aws-actions/configure-aws-credentials@e1253824e5c10ff9df46874f81ed3ec929e19cfd # v6.3.0
        with:
          role-to-assume: ${{ vars.{{ infra.deploy_role_variable }} }}
          aws-region: ${{ env.AWS_REGION }}
      - name: Log in to the registry
        run: >-
          aws ecr get-login-password --region "$AWS_REGION" |
          docker login --username AWS --password-stdin "${IMAGE_REPO%%/*}"
      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
      - name: Build image (not pushed yet)
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: .
          load: true
          tags: ${{ env.IMAGE_REPO }}:${{ github.sha }}
          cache-from: type=registry,ref=${{ env.IMAGE_REPO }}:cache
      - name: Scan image (fail on CRITICAL/HIGH)
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          image-ref: ${{ env.IMAGE_REPO }}:${{ github.sha }}
          exit-code: "1"
          ignore-unfixed: true
          severity: CRITICAL,HIGH
      - name: Push image
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: .
          push: true
          tags: ${{ env.IMAGE_REPO }}:${{ github.sha }}
          cache-from: type=registry,ref=${{ env.IMAGE_REPO }}:cache
          cache-to: type=registry,ref=${{ env.IMAGE_REPO }}:cache,mode=max
{{#if infra.argocd}}
  # ── Stage 3b · record the release in git (the only job that can write) ─────
  # Separate job on purpose: the push credential exists only here, never next to
  # third-party actions (scanner, build) that run in the job above.
  release:
    name: "Stage 3b · commit image tag"
    needs: deploy
    runs-on: ubuntu-latest
    environment: {{ infra.environment }}
    timeout-minutes: 10
    permissions:
      contents: write # push the image-tag commit
    outputs:
      revision: ${{ steps.commit.outputs.revision }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # zizmor: ignore[artipacked] this job must push and uploads no artifacts
          persist-credentials: true  # this job only: pushes the tag commit
      - name: Commit the new image tag (ArgoCD deploys from git)
        id: commit
        env:
          IMAGE: ${{ env.IMAGE_REPO }}:${{ github.sha }}
        run: |
          set -euo pipefail
          file="{{ infra.k8s_dir }}/app/deployment.yaml"
          sed -i -E "s|^([[:space:]]*image:[[:space:]]*).*${APP_NAME}:.*$|\1${IMAGE}|" "$file"
          if ! git diff --quiet -- "$file"; then
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git commit -m "chore(deploy): ${APP_NAME} image ${GITHUB_SHA} [skip ci]" -- "$file"
            # Fails if the default branch requires PRs: allow this bot or use a deploy branch.
            git push origin "HEAD:${GITHUB_REF_NAME}"
          fi
          echo "revision=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"

  # ── Stage 3c · wait for ArgoCD to run THIS revision ────────────────────────
  verify:
    name: "Stage 3c · wait for ArgoCD"
    needs: release
    runs-on: ubuntu-latest
    environment: {{ infra.environment }}
    timeout-minutes: 15
    permissions:
      contents: read # checkout
      id-token: write # assume the AWS role via OIDC
    steps:
      - uses: aws-actions/configure-aws-credentials@e1253824e5c10ff9df46874f81ed3ec929e19cfd # v6.3.0
        with:
          role-to-assume: ${{ vars.{{ infra.deploy_role_variable }} }}
          aws-region: ${{ env.AWS_REGION }}
      - uses: azure/setup-kubectl@bda439f5f36b99b262ebdcd3613869bddb064c8e # v5.2.0
      - name: Configure cluster access
        run: aws eks update-kubeconfig --name "$CLUSTER_NAME" --region "$AWS_REGION"
      - name: Wait for Synced + Healthy at the new revision
        env:
          REVISION: ${{ needs.release.outputs.revision }}
        run: |
          set -euo pipefail
          app="application/${APP_NAME}"
          # Ask ArgoCD to look at git now instead of at its next poll.
          kubectl -n argocd annotate "$app" argocd.argoproj.io/refresh=normal --overwrite
          # Waiting on "Synced" alone would pass instantly on the OLD revision.
          kubectl -n argocd wait "$app" --for=jsonpath='{.status.sync.revision}'="$REVISION" --timeout=600s
          kubectl -n argocd wait "$app" --for=jsonpath='{.status.sync.status}'=Synced --timeout=300s
          kubectl -n argocd wait "$app" --for=jsonpath='{.status.health.status}'=Healthy --timeout=300s
{{else}}      - uses: azure/setup-kubectl@bda439f5f36b99b262ebdcd3613869bddb064c8e # v5.2.0
      - name: Configure cluster access
        run: aws eks update-kubeconfig --name "$CLUSTER_NAME" --region "$AWS_REGION"
      - name: Apply manifests
        env:
          IMAGE: ${{ env.IMAGE_REPO }}:${{ github.sha }}
        run: |
          set -euo pipefail
          kubectl apply -n "$NAMESPACE" -f {{ infra.k8s_dir }}/app/
          kubectl set image -n "$NAMESPACE" "deployment/${APP_NAME}" "${APP_NAME}=${IMAGE}"
      - name: Wait for rollout
        run: kubectl rollout status -n "$NAMESPACE" "deployment/${APP_NAME}" --timeout=300s
{{/if}}
