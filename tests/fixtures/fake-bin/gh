"""Fake `gh` CLI for offline tests: pull requests against a local git remote.

State lives in $FAKE_GH_STATE (JSON). Supported:
  gh pr create [--title T] [--body B] [--fill] [--base main]
  gh pr checks [<n>] [--repo R] --json name,bucket   (exit 8 while not all green, like gh)
  gh pr view [<n>] [--json number,state,headRefName]
  gh pr merge [<n>] [--merge|--squash] [--repo R]    (merges the branch into base on origin)
  gh auth status
Tests set check results directly in the state file: {"checks": [{"name":..,"bucket":..}]}.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

STATE = Path(os.environ.get("FAKE_GH_STATE", "fake-gh-state.json"))


def load() -> dict:
    try:
        return json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return {"prs": {}, "next": 1}


def save(state: dict) -> None:
    STATE.write_text(json.dumps(state, indent=2))


def git(*args: str) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.strip()


def flag(args: list[str], name: str, default: str = "") -> str:
    return (
        args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else default
    )


def positional(args: list[str]) -> str | None:
    skip = {"--title", "--body", "--base", "--repo", "-R", "--json", "-t", "-b", "-B"}
    i = 0
    while i < len(args):
        if args[i] in skip:
            i += 2
            continue
        if not args[i].startswith("-"):
            return args[i]
        i += 1
    return None


def current_pr(state: dict, args: list[str]) -> dict | None:
    n = positional(args)
    if n is not None:
        return state["prs"].get(str(n))
    branch = git("branch", "--show-current")
    return next(
        (p for p in state["prs"].values() if p["head"] == branch and p["state"] == "OPEN"), None
    )


def main() -> int:
    args = sys.argv[1:]
    if args[:2] == ["auth", "status"]:
        print("Logged in to github.com (fake)")
        return 0
    if args[:1] != ["pr"] or len(args) < 2:
        print(f"fake gh: unsupported command: {' '.join(args)}", file=sys.stderr)
        return 1
    state, sub, rest = load(), args[1], args[2:]

    if sub == "create":
        head = git("branch", "--show-current")
        n = str(state["next"])
        state["next"] += 1
        state["prs"][n] = {
            "number": int(n),
            "head": head,
            "base": flag(rest, "--base", "main"),
            "title": flag(rest, "--title", head),
            "state": "OPEN",
            "checks": [{"name": "tests", "bucket": "pending"}],
        }
        save(state)
        print(f"https://github.com/example/repo/pull/{n}")
        return 0

    pr = current_pr(state, rest)
    if pr is None:
        print("no pull requests found", file=sys.stderr)
        return 1

    if sub == "checks":
        checks = pr["checks"]
        print(json.dumps([{"name": c["name"], "bucket": c["bucket"]} for c in checks]))
        return 0 if checks and all(c["bucket"] in ("pass", "skipping") for c in checks) else 8
    if sub == "view":
        print(json.dumps({"number": pr["number"], "state": pr["state"], "headRefName": pr["head"]}))
        return 0
    if sub == "merge":
        if pr["state"] != "OPEN":
            print(f"pull request #{pr['number']} is not open", file=sys.stderr)
            return 1
        # Merge on the remote's history via a temporary worktree, like GitHub would.
        git("fetch", "-q", "origin")
        wt = Path(git("rev-parse", "--git-dir")).resolve() / "fake-gh-merge"
        subprocess.run(["git", "worktree", "remove", "--force", str(wt)], capture_output=True)
        git("worktree", "add", "-q", "--detach", str(wt), f"origin/{pr['base']}")
        subprocess.run(
            [
                "git",
                "-C",
                str(wt),
                "merge",
                "-q",
                "--no-ff",
                "-m",
                f"Merge pull request #{pr['number']}",
                f"origin/{pr['head']}",
            ],
            check=True,
        )
        subprocess.run(
            ["git", "-C", str(wt), "push", "-q", "origin", f"HEAD:{pr['base']}"], check=True
        )
        git("worktree", "remove", "--force", str(wt))
        pr["state"] = "MERGED"
        save(state)
        print(f"Merged pull request #{pr['number']}")
        return 0
    print(f"fake gh: unsupported: pr {sub}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
